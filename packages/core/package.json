{
  "name": "logsguardian",
  "version": "0.1.0",
  "description": "Middleware RASP de deteccion de amenazas (SQLi, XSS, Path Traversal, Command Injection) para Node.js/Express, con inferencia ONNX (Random Forest + Isolation Forest)",
  "keywords": [
    "rasp",
    "security",
    "middleware",
    "express",
    "waf",
    "sqli",
    "xss",
    "path-traversal",
    "command-injection",
    "intrusion-detection",
    "machine-learning",
    "onnx"
  ],
  "homepage": "https://github.com/xtsebas/logSguarDian/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/xtsebas/logSguarDian/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xtsebas/logSguarDian.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "contributors": [
    { "name": "Sebastian Huertas" },
    { "name": "Diego Valenzuela" }
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "logsguardian": "dist/cli.js"
  },
  "files": [
    "dist",
    "models",
    "data",
    "scripts"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postbuild": "cp ../../training/models/class_metrics.json data/ && cp ../../training/models/feature_importance.json data/ && cp ../../training/models/rf.onnx models/ && cp ../../training/models/if.onnx models/",
    "postinstall": "node scripts/postinstall.js",
    "test": "jest"
  },
  "dependencies": {
    "@logsguardian/extractor": "workspace:*",
    "better-sqlite3": "^11.0.0",
    "onnxruntime-node": "^1.19.0"
  },
  "bundledDependencies": [
    "@logsguardian/extractor"
  ],
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.9",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.5.0"
  }
}
