# data
/data/

# packages/core bundles class_metrics.json + feature_importance.json from
# training/models/ at build time (postbuild script) — ship them in the package
!packages/core/data/
!packages/core/data/class_metrics.json
!packages/core/data/feature_importance.json

# Claude
.claude/

# Node
node_modules/
dist/
coverage/
*.tsbuildinfo
*.log

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store

# Environment
.env
.env.*

# VS Code
.vscode/

# Large training data (regenerate from parsers + extractor CLI)
training/data_clean/*.jsonl
training/data_clean/*.csv
training/data_clean/*.parquet
training/data_clean/near_duplicates_report.txt
training/splits/*.parquet

# Sklearn model binaries — RF pkls are large (rf_v2.pkl = 18MB); use ONNX for inference
training/models/*.pkl
# IF pkls are small (~1MB) and needed for local reproducibility without re-running F3.5
!training/models/if_v*.pkl

# packages/core bundles ONNX models from training/models/ at build/publish time;
# avoid duplicating the binaries in git (training/models/ is the source of truth)
packages/core/models/*.onnx
*.tgz

# MLOps: generated SQLite telemetry / SQLite databases (regenerate via simulate-fleet)
*.db
packages/mlops/data/

# MLOps CT pipeline: candidate models and production backups (training/ct_pipeline.py) —
# regenerable, never committed; only a promoted (Fase 8) rf.onnx/if.onnx is tracked
training/models/*_candidate*.onnx
training/models/.*.production_backup
